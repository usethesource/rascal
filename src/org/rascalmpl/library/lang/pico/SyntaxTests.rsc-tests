module lang::pico::tests::SyntaxTests

import lang::pico::\syntax::Main;

syntax test exp1 (Expression) expects ok {
1 + 1 + 1
}

syntax test exp2 (Expression) expects ok {
1 || 1 || 1
}

syntax test exp3 (Expression)  expects ok {
1 + 1 || 1
}

syntax test exp3 (Expression) expects ok {
1 || 1 + 1
}

syntax test p1 (Program) expects ok {
begin
    declare a : natural;
    a := 10
end
}

syntax test p2 (Program) expects error {
%% illegal comment before Program
begin
    declare a : natural;
    a := 10
end
}


syntax test s1 (start[Program]) expects ok {
% comment at the start %
begin
    declare a : natural;
    a := 10
end
%% comment at the end
}